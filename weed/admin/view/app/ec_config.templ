package app

import (
	"fmt"

	"github.com/seaweedfs/seaweedfs/weed/admin/dash"
)

// ECConfigPage edits the cluster's EC ratio policy: one global default plus
// per-collection overrides. The document lives in the filer (see ec.config) and
// is what new EC volumes are encoded with; a volume that already records a ratio
// in its own .vif keeps it.
templ ECConfigPage(data dash.ECConfigForkView) {
	<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
		<div>
			<h1 class="h2">
				<i class="bi bi-shield-check me-2"></i>EC Configuration
			</h1>
			<nav aria-label="breadcrumb">
				<ol class="breadcrumb">
					<li class="breadcrumb-item"><a href={ dash.PUrl(ctx, "/admin") } class="text-decoration-none">Dashboard</a></li>
					<li class="breadcrumb-item"><a href={ dash.PUrl(ctx, "/storage/volumes") } class="text-decoration-none">Storage</a></li>
					<li class="breadcrumb-item active" aria-current="page">EC Configuration</li>
				</ol>
			</nav>
		</div>
		<div class="btn-toolbar mb-2 mb-md-0">
			<div class="btn-group me-2">
				<button type="button" class="btn btn-sm btn-outline-primary" onclick="window.location.reload()">
					<i class="bi bi-arrow-clockwise me-1"></i>Refresh
				</button>
			</div>
		</div>
	</div>

	if !data.FilerAvailable {
		<div class="alert alert-warning">
			<i class="bi bi-exclamation-triangle me-2"></i>
			<strong>No filer discovered.</strong> The policy is stored in the filer, so it can be neither read nor saved right now.
		</div>
	}

	<div class="alert alert-info">
		<i class="bi bi-info-circle me-2"></i>
		This ratio applies to <strong>new EC volumes only</strong>. A volume that already records a ratio in its
		<code>.vif</code> keeps it, which is also what keeps a mixed cluster readable volume by volume.
	</div>

	<div class="row">
		<div class="col-lg-5">
			<div class="card shadow mb-4">
				<div class="card-header py-3">
					<h6 class="m-0 font-weight-bold text-primary"><i class="bi bi-globe me-2"></i>Global default</h6>
				</div>
				<div class="card-body">
					if data.Global != nil {
						<p class="mb-3">
							Current: <span class="badge bg-primary">{fmt.Sprintf("%d+%d", data.Global.DataShards, data.Global.ParityShards)}</span>
						</p>
					} else {
						<p class="mb-3 text-muted">
							No global policy: new volumes use the build default
							<span class="badge bg-secondary">{fmt.Sprintf("%d+%d", data.BuildDataShards, data.BuildParityShards)}</span>
							unless a collection override applies.
						</p>
					}
					<form id="ecGlobalForm">
						<div class="row g-2 align-items-end">
							<div class="col-4">
								<label for="globalDataShards" class="form-label">Data Shards</label>
								<input type="number" min="1" max="31" required class="form-control" id="globalDataShards"
									if data.Global != nil { value={ fmt.Sprintf("%d", data.Global.DataShards) } } />
							</div>
							<div class="col-4">
								<label for="globalParityShards" class="form-label">Parity Shards</label>
								<input type="number" min="1" max="31" required class="form-control" id="globalParityShards"
									if data.Global != nil { value={ fmt.Sprintf("%d", data.Global.ParityShards) } } />
							</div>
							<div class="col-4 d-flex gap-2">
								<button type="submit" class="btn btn-primary" if !data.FilerAvailable { disabled }>
									<i class="bi bi-save me-1"></i>Save
								</button>
								<button type="button" class="btn btn-outline-secondary" onclick="clearGlobal()" if !data.FilerAvailable { disabled }>
									Clear
								</button>
							</div>
						</div>
						<div class="form-text mt-2">Data plus parity must not exceed 32.</div>
					</form>
				</div>
			</div>
		</div>

		<div class="col-lg-7">
			<div class="card shadow mb-4">
				<div class="card-header py-3">
					<h6 class="m-0 font-weight-bold text-primary"><i class="bi bi-collection me-2"></i>Collection overrides</h6>
				</div>
				<div class="card-body">
					<button type="button" class="btn btn-sm btn-outline-primary mb-3" data-bs-toggle="modal" data-bs-target="#ecCollectionModal" if !data.FilerAvailable { disabled }>
						<i class="bi bi-plus-lg me-1"></i>Add override
					</button>
					if len(data.Collections) == 0 {
						<p class="text-muted mb-0">No collection overrides: every collection follows the global default.</p>
					} else {
						<div class="table-responsive">
							<table class="table table-sm table-hover align-middle mb-0">
								<thead class="table-light">
									<tr>
										<th>Collection</th>
										<th>Ratio</th>
										<th class="text-end">Actions</th>
									</tr>
								</thead>
								<tbody>
									for _, override := range data.Collections {
										<tr>
											<td><code>{override.Collection}</code></td>
											<td><span class="badge bg-primary">{fmt.Sprintf("%d+%d", override.DataShards, override.ParityShards)}</span></td>
											<td class="text-end">
												<button type="button" class="btn btn-sm btn-outline-secondary"
													data-collection={ override.Collection }
													data-shards={ fmt.Sprintf("%d", override.DataShards) }
													data-parity={ fmt.Sprintf("%d", override.ParityShards) }
													onclick="editCollection(this)">
													<i class="bi bi-pencil me-1"></i>Edit
												</button>
												<button type="button" class="btn btn-sm btn-outline-danger"
													data-collection={ override.Collection }
													onclick="deleteCollection(this)">
													<i class="bi bi-trash me-1"></i>Delete
												</button>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</div>
			</div>
		</div>
	</div>

	<div class="modal fade" id="ecCollectionModal" tabindex="-1">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="ecCollectionModalTitle">Add collection override</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
				</div>
				<form id="ecCollectionForm">
					<div class="modal-body">
						<div class="mb-3">
							<label for="ecCollectionName" class="form-label">Collection</label>
							<input type="text" class="form-control" id="ecCollectionName" required />
						</div>
						<div class="row g-2">
							<div class="col-6">
								<label for="ecCollectionDataShards" class="form-label">Data Shards</label>
								<input type="number" min="1" max="31" required class="form-control" id="ecCollectionDataShards" />
							</div>
							<div class="col-6">
								<label for="ecCollectionParityShards" class="form-label">Parity Shards</label>
								<input type="number" min="1" max="31" required class="form-control" id="ecCollectionParityShards" />
							</div>
						</div>
						<div class="form-text mt-2">Data plus parity must not exceed 32.</div>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
						<button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save</button>
					</div>
				</form>
			</div>
		</div>
	</div>

	<script>
		(function () {
			function getCSRFToken() {
				var meta = document.querySelector('meta[name="csrf-token"]');
				return meta ? (meta.getAttribute('content') || '') : '';
			}

			function base(url) {
				return (window.__BASE_PATH__ || '') + url;
			}

			function notify(message, level) {
				if (typeof window.showAlert === 'function') {
					window.showAlert(message, level || 'info');
					return;
				}
				if (level === 'error') {
					console.error(message);
				}
				alert(message);
			}

			async function ecConfigRequest(url, payload) {
				var headers = { 'Content-Type': 'application/json' };
				var csrf = getCSRFToken();
				if (csrf) {
					headers['X-CSRF-Token'] = csrf;
				}
				var response = await fetch(base(url), {
					method: 'POST',
					headers: headers,
					body: JSON.stringify(payload),
				});
				var bodyText = await response.text();
				var data = {};
				if (bodyText) {
					try {
						data = JSON.parse(bodyText);
					} catch (e) {
						data = { error: bodyText };
					}
				}
				if (!response.ok) {
					throw new Error(data.error || data.message || ('Request failed: ' + response.status));
				}
				return data;
			}

			function readPair(dataShardsId, parityShardsId) {
				return {
					dataShards: parseInt(document.getElementById(dataShardsId).value, 10),
					parityShards: parseInt(document.getElementById(parityShardsId).value, 10),
				};
			}

			document.getElementById('ecGlobalForm').addEventListener('submit', async function (event) {
				event.preventDefault();
				var pair = readPair('globalDataShards', 'globalParityShards');
				if (!(pair.dataShards > 0 && pair.parityShards > 0 && pair.dataShards + pair.parityShards <= 32)) {
					notify('Data and parity shards must both be positive and sum to at most 32.', 'error');
					return;
				}
				try {
					await ecConfigRequest('/api/ec/config/global', pair);
					notify('Global EC ratio saved. It applies to new EC volumes.', 'success');
					window.location.reload();
				} catch (e) {
					notify('Error: ' + e.message, 'error');
				}
			});

			function clearGlobal() {
				if (!confirm('Clear the global EC ratio? New volumes will use the build default again.')) {
					return;
				}
				ecConfigRequest('/api/ec/config/global/delete', {})
					.then(function () {
						notify('Global EC ratio cleared.', 'success');
						window.location.reload();
					})
					.catch(function (e) {
						notify('Error: ' + e.message, 'error');
					});
			}

			document.getElementById('ecCollectionForm').addEventListener('submit', async function (event) {
				event.preventDefault();
				var collection = (document.getElementById('ecCollectionName').value || '').trim();
				var pair = readPair('ecCollectionDataShards', 'ecCollectionParityShards');
				if (!collection) {
					notify('A collection name is required.', 'error');
					return;
				}
				if (!(pair.dataShards > 0 && pair.parityShards > 0 && pair.dataShards + pair.parityShards <= 32)) {
					notify('Data and parity shards must both be positive and sum to at most 32.', 'error');
					return;
				}
				pair.collection = collection;
				try {
					await ecConfigRequest('/api/ec/config/collection', pair);
					notify('Collection EC ratio saved. It applies to new EC volumes in this collection.', 'success');
					window.location.reload();
				} catch (e) {
					notify('Error: ' + e.message, 'error');
				}
			});

			window.editCollection = function (button) {
				document.getElementById('ecCollectionModalTitle').textContent = 'Edit collection override';
				document.getElementById('ecCollectionName').value = button.getAttribute('data-collection') || '';
				document.getElementById('ecCollectionDataShards').value = button.getAttribute('data-shards') || '';
				document.getElementById('ecCollectionParityShards').value = button.getAttribute('data-parity') || '';
				bootstrap.Modal.getOrCreateInstance(document.getElementById('ecCollectionModal')).show();
			};

			window.deleteCollection = function (button) {
				var collection = button.getAttribute('data-collection') || '';
				if (!confirm('Delete the override for "' + collection + '"? It will follow the global default.')) {
					return;
				}
				ecConfigRequest('/api/ec/config/collection/delete', { collection: collection })
					.then(function () {
						notify('Override deleted.', 'success');
						window.location.reload();
					})
					.catch(function (e) {
						notify('Error: ' + e.message, 'error');
					});
			};
		})();
	</script>
}
